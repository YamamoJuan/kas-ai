LLM_API_KEY=
LLM_BASE_URL=https://api.gutsai.id/v1
LLM_MODEL=nemotron-3-super

# Guts AI juga menyediakan: laguna-s2.1
# Tinggal ganti LLM_MODEL di atas, contoh:
# LLM_MODEL=laguna-s2.1

# Optional overrides
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=5
