# Template Secrets Streamlit.
#
# Lokal:
#   1. Salin file ini menjadi `.streamlit/secrets.toml`
#   2. Isi nilai di bawah.
#
# Streamlit Community Cloud:
#   1. Buka dashboard app → Settings → Secrets
#   2. Tempel seluruh isi file ini ke kotak Secrets
#   3. Simpan dan reboot app.

LLM_API_KEY = "sk-guts-..."
LLM_BASE_URL = "https://api.gutsai.id/v1"
LLM_MODEL = "laguna-s2.1"

# Opsional
EMBEDDING_MODEL = "sentence-transformers/all-MiniLM-L6-v2"
CHUNK_SIZE = 500
CHUNK_OVERLAP = 100
TOP_K = 5
